generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id                String                 @id @default(cuid())
  email             String                 @unique
  username          String?                @unique
  displayName       String?
  passwordHash      String?
  role              String                 @default("user")
  emailVerifiedAt   DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  avatarUrl         String?
  avatarPublicId    String?
  dailyGoalMin      Int                    @default(15)
  levelId           String?
  googleSub         String?                @unique
  learnedWordsCount Int                    @default(0)
  oauthProvider     String?
  accounts          Account[]
  learnedWords      LearningProgress[]
  sessions          Session[]
  tokens            Token[]
  level             Level?                 @relation(fields: [levelId], references: [id])
  progress          UserExerciseProgress[]
  chatConversations ChatConversation[]
  notifications     Notification[]

  pushSubscriptions PushSubscription[]

  practiceRemindersEnabled Boolean                @default(true)
  smartReminderTime        String                 @default("20:00")

  @@index([levelId])
}

model Token {
  id        String    @id @default(cuid())
  type      TokenType
  codeHash  String
  expiresAt DateTime
  sentAt    DateTime  @default(now())
  usedAt    DateTime?
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, expiresAt])
  @@index([userId, type, sentAt])
}

model Level {
  id                      String    @id @default(cuid())
  code                    CefrLevel @unique
  name                    String
  description             String?
  order                   Int       @unique
  recommendedMinPerLesson Int       @default(10)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  lessons                 Lesson[]
  users                   User[]
}

model Lesson {
  id           String     @id @default(cuid())
  levelId      String
  title        String
  description  String?
  estimatedMin Int        @default(10)
  primarySkill SkillType  @default(LISTENING)
  order        Int
  isPublished  Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  exercises    Exercise[]
  level        Level      @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([levelId, order])
  @@index([levelId, isPublished])
}

model Exercise {
  id           String                 @id @default(cuid())
  lessonId     String
  type         ExerciseType
  skill        SkillType
  title        String
  instruction  String?
  mediaUrl     String?
  contentJson  Json?
  estimatedMin Int                    @default(5)
  order        Int
  isPublished  Boolean                @default(false)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  lesson       Lesson                 @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  progress     UserExerciseProgress[]

  @@unique([lessonId, order])
  @@index([lessonId, isPublished])
  @@index([type, skill])
}

model UserExerciseProgress {
  id             String         @id @default(cuid())
  userId         String
  exerciseId     String
  status         ProgressStatus @default(NOT_STARTED)
  progressPct    Int            @default(0)
  timeSpentMin   Int            @default(0)
  score          Float?
  lastAccessedAt DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  exercise       Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, exerciseId])
  @@index([userId, status])
  @@index([exerciseId])
}

model LearningProgress {
  id        String   @id @default(cuid())
  userId    String
  level     String
  wordId    Int
  word          String
  meaning       String
  pronunciation String?
  partOfSpeech  String?
  learnedAt     DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, level, wordId])
  @@index([userId, learnedAt])
  @@index([userId, level])
}

model AiFeedback {
  id                String   @id @default(cuid())
  userId            String?  // nullable if anonymous
  sessionId         String?
  messageId         String
  assistantContent  String
  previousUserInput String?
  feedbackType      String
  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([sessionId])
  @@index([messageId])
}

enum TokenType {
  EMAIL_VERIFY
  LOGIN_2FA
  PASSWORD_RESET
}

enum CefrLevel {
  PRE_A1
  A1
  A2
  B1
  B2
  C1
  C2
}

enum SkillType {
  LISTENING
  SPEAKING
}

enum ExerciseType {
  SHADOWING
  DICTATION
  PRONUNCIATION
  ROLEPLAY
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model ChatConversation {
  id        String   @id @default(cuid())
  userId    String?
  sessionId String?  @unique
  messages  Json
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("SYSTEM")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
